{
  "name": "hazeschaden",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @hazeschaden/client dev",
    "dev:lan": "pnpm --filter @hazeschaden/client dev:lan",
    "build": "pnpm --filter @hazeschaden/client build",
    "preview": "pnpm --filter @hazeschaden/client preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @hazeschaden/client typecheck",
    "balance": "tsx packages/sim/scripts/balance.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
